{
  "name": "zeekr-shortcut-sentrymode-on",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "Turns on Zeekr sentry mode when the car is parked outside your geofences (Cloudflare Workers)",
  "author": "dts88",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dts88/zeekr-shortcut-sentrymode-on"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/run.mjs --dry-run",
    "test": "node --test",
    "cf:deploy": "wrangler deploy",
    "cf:secrets": "wrangler secret bulk .dev.vars",
    "cf:logs": "wrangler tail",
    "gh:run": "gh workflow run sentry.yml",
    "gh:live": "gh workflow run sentry.yml -f dry_run=false"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "^4.151.0"
  }
}
